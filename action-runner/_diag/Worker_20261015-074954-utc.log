              "lit": "$ErrorActionPreference = \"Stop\"\nSet-Location C:\\quyhdp\\nkdd-report\\bvkhanhhoi_dieuduong\ngit config --global --add safe.directory C:/quyhdp/nkdd-report/bvkhanhhoi_dieuduong\n\nWrite-Host \"=== git sync ===\"\n$ErrorActionPreference = \"Continue\"\ngit merge --abort 2>$null\n$ErrorActionPreference = \"Stop\"\ngit fetch origin main\nif ($LASTEXITCODE -ne 0) { throw \"git fetch failed\" }\ngit reset --hard origin/main\nif ($LASTEXITCODE -ne 0) { throw \"git reset failed\" }\ngit log -1 --format=\"Deployed commit: %h %s\"\n\nWrite-Host \"=== stopping service ===\"\nsc.exe stop NKDD-Report | Out-Null\n\n# Diệt cưỡng bức ngay, không chờ service tự dừng\nGet-CimInstance Win32_Process |\n  Where-Object { $_.Name -in @(\"node.exe\",\"npm.cmd\",\"cmd.exe\") -and $_.CommandLine -like \"*bvkhanhhoi_dieuduong*\" } |\n  ForEach-Object { Write-Host \"Kill $($_.ProcessId)\"; Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }\n\n# Chờ tối đa 20 giây rồi đi tiếp dù service chưa báo Stopped\nfor ($i = 0; $i -lt 10; $i++) {\n  if ((Get-Service NKDD-Report).Status -eq \"Stopped\") { break }\n  Start-Sleep -Seconds 2\n}\nWrite-Host \"Service status: $((Get-Service NKDD-Report).Status)\"\nStart-Sleep -Seconds 3\n\ntry {\n  Write-Host \"=== npm ci ===\"\n  npm ci\n  if ($LASTEXITCODE -ne 0) { throw \"npm ci failed\" }\n\n  Write-Host \"=== prisma generate ===\"\n  npx prisma generate\n  if ($LASTEXITCODE -ne 0) { throw \"prisma generate failed\" }\n\n  Write-Host \"=== build ===\"\n  npm run build\n  if ($LASTEXITCODE -ne 0) { throw \"build failed\" }\n}\nfinally {\n  Write-Host \"=== starting service ===\"\n  Start-Service \"NKDD-Report\"\n}\n\nStart-Sleep -Seconds 10\nnetstat -ano | findstr :5433\nGet-Service NKDD-Report\n"
            }
          }
        ]
